pipeline {
    agent any

    environment {
        IMAGE_NAME = 'rachita06/jobsathi-ui'
        IMAGE_TAG  = 'latest'
        KUBECONFIG = '/var/jenkins_home/.kube/config'
        NAMESPACE  = 'dev'
    }

    stages {
        stage('Checkout') {
            steps {
                // Clone GitHub repo with credentials
                git credentialsId: 'git-06', url: 'https://github.com/rachita06/job-sathi-ui.git', branch: 'main'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    // Build Docker image
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    // Push Docker image to Docker Hub using docker-06 credentials
                    docker.withRegistry('https://index.docker.io/v1/', 'docker-06') {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Apply deployment and service YAML to Kubernetes
                    sh "kubectl apply -f jobsathiUI-kubernatesfile/deployment.yaml -n ${NAMESPACE}"
                    sh "kubectl apply -f jobsathiUI-kubernatesfile/service.yaml -n ${NAMESPACE}"
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    // Check pods and service status
                    sh "kubectl get pods -n ${NAMESPACE}"
                    sh "kubectl get svc -n ${NAMESPACE}"
                }
            }
        }
    }

    post {
        success {
            echo " Deployment successful! Check your app at NodePort 30085"
        }
        failure {
            echo " Deployment failed. Check logs for errors."
        }
    }
}
